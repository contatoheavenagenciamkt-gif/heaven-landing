# Copie para .env na VPS e preencha. O .env NUNCA vai pro git.
#   cp .env.example .env && nano .env

# --- Banco -------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=heaven_api
DB_PASSWORD=troque_esta_senha
DB_NAME=heaven

# --- Servidor ----------------------------------------------------------------
# A API escuta só em localhost: quem fala com o mundo é o nginx.
PORT=3001
HOST=127.0.0.1

# production ativa cookie Secure (exige HTTPS). Em teste local, use development.
NODE_ENV=production

# --- Segurança ---------------------------------------------------------------
# Sal usado para o hash do IP no tracking. Gere um valor aleatório e não mude
# depois — mudar reinicia a contagem de visitantes únicos.
#   openssl rand -hex 32
IP_SALT=troque_por_um_valor_aleatorio_longo

# Quantos dias a sessão do painel dura.
SESSAO_DIAS=7
